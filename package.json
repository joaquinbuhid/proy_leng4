{
  "name": "portfolio-fullstack",
  "version": "1.0.0",
  "private": true,
  "homepage": ".",
  "main": "server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server.js\" \"react-scripts start\"",
    "build": "react-scripts build",
    "start": "node server.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "express": "^4.22.3",
    "nodemailer": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "react-scripts": "^5.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "http-proxy-middleware": "^2.0.11"
  }
}
