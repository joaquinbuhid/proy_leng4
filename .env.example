# Copiá este archivo como .env (en tu PC) o cargá estas variables en hPanel (Hostinger).

# Email para el formulario de contacto (SMTP de Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contacto@tudominio.com
SMTP_PASS=
# A dónde llegan las consultas (si se deja vacío, a SMTP_USER)
CONTACT_TO=

# Clave para firmar las sesiones (cualquier texto largo y aleatorio)
SESSION_SECRET=

# Carpeta donde se guardan los JSON (opcional, por defecto ./data)
DATA_DIR=
